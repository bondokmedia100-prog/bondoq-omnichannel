{
  "name": "@bondoq/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:replace-catalog": "tsx prisma/replaceCatalog.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.40.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^22.13.4",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
